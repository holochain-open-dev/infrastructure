{
  "name": "@holochain-open-dev/common-dev",
  "private": true,
  "workspaces": [
    "packages/utils",
    "packages/core-types",
    "packages/elements",
    "packages/stores",
    "packages/signals",
    "sites/*"
  ],
  "engines": {
    "npm": ">=7.0.0"
  },
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "test": "npm test --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present"
  },
  "devDependencies": {
    "@open-wc/eslint-config": "^9.2.2",
    "eslint-config-prettier": "^8.6.0",
    "prettier": "^2.8.4"
  }
}
