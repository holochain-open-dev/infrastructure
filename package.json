{
  "name": "@holochain-open-dev/common-dev",
  "private": true,
  "workspaces": [
    "packages/utils",
    "packages/core-types",
    "packages/elements",
    "packages/stores",
    "packages/signals",
    "sites/*"
  ],
  "engines": {
    "npm": ">=7.0.0"
  },
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "test": "npm test --workspaces --if-present",
    "lint": "eslint .",
    "format": "prettier --write ."
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.2.1",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.8.3",
    "typescript-eslint": "^8.59.0"
  }
}
