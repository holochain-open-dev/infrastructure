{
  "name": "@holochain-open-dev/elements",
  "version": "0.601.2",
  "description": "Common utilities and elements to build Holochain web applications",
  "author": "guillem.cordoba@gmail.com",
  "main": "dist/index.js",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/holochain-open-dev/common.git"
  },
  "exports": {
    ".": "./dist/index.js",
    "./dist/*": "./dist/*"
  },
  "scripts": {
    "start": "vite --open",
    "build": "tsc && npm run analyze -- --exclude dist",
    "analyze": "cem analyze --litelement",
    "prepublish": "npm run build"
  },
  "devDependencies": {
    "@custom-elements-manifest/analyzer": "^0.11.0",
    "concurrently": "^9.2.1",
    "tslib": "^2.8.1",
    "typescript": "~5.9.0",
    "vite": "^6.4.2",
    "vite-plugin-checker": "^0.13.0"
  },
  "dependencies": {
    "@holo-host/identicon": "^0.1.0",
    "@holochain/client": "^0.20.5",
    "@lit/localize": "^0.12.2",
    "@mdi/js": "^7.4.47",
    "@shoelace-style/shoelace": "^2.20.1",
    "lit": "^3.0.2",
    "prosemirror-commands": "^1.5.2",
    "prosemirror-keymap": "^1.2.2",
    "prosemirror-state": "^1.4.3",
    "prosemirror-view": "^1.31.3"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "customElements": "custom-elements.json"
}
