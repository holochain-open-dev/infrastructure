{
  "name": "@holochain-open-dev/utils",
  "version": "0.601.0",
  "description": "Common utilities to build Holochain web applications",
  "author": "guillem.cordoba@gmail.com",
  "main": "dist/index.js",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": ["dist"],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/holochain-open-dev/common.git"
  },
  "exports": {
    ".": "./dist/index.js",
    "./dist/*": "./dist/*"
  },
  "scripts": {
    "build": "tsc",
    "build:watch": "tsc --watch --preserveWatchOutput",
    "lint": "eslint --ext .ts,.html . --ignore-path .gitignore",
    "test": "vitest run",
    "prepublish": "npm run build"
  },
  "devDependencies": {
    "@types/lodash-es": "^4.17.6",
    "@types/libsodium-wrappers": "^0.7.14",
    "typescript": "~5.9.0",
    "vite": "^4.1.1",
    "vitest": "^1.4.0"
  },
  "dependencies": {
    "@holochain/client": "=0.20.4-rc.0",
    "@msgpack/msgpack": "^2.8.0",
    "blakejs": "^1.2.1",
    "emittery": "^1.0.1",
    "lodash-es": "^4.17.21",
    "sort-keys": "^5.0.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "customElements": "custom-elements.json"
}
